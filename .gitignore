# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.python-version

# --- IDE / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Runtime / regenerable artifacts ---
frames/
legacy/
*.log
*.part.mp4
