# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Runtime / regenerable artifacts ---
frames/
legacy/
edited_1/
eval/
*.log
*.part.mp4
.*.part.mp4

# Scratch / one-off scripts (local only)
scripts/_*.py
scripts/_*/

# --- Media: never commit videos / bulk images ---
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.wmv
*.flv
*.mpeg
*.mpg
*.3gp
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.ico
*.svg
images/

# Keep pack asset docs + small fonts + style previews in repo
!assets/
!assets/**
!assets/text_previews/*.png
!assets/stickers/previews/*.png
!assets/style_board/*.png
!assets/fonts/*.ttf
!assets/fonts/*.otf

# BGM audio is large — keep only markdown docs in git
assets/music/**
!assets/music/**/
!assets/music/**/*.md

# Do not commit random audio dumps under assets/
assets/*.mp3
assets/*.m4a
assets/*.wav
assets/*.aac
assets/*.flac
assets/*.ogg

# Sticker scratch / generated APNG cache / Noto GIF download cache
assets/stickers/external/
assets/stickers/_candidates/
assets/stickers/.generated/
assets/style_board/_sticker_work/
assets/style_board/_tmp_*/
assets/stickers/*.apng
assets/stickers/preview_*.jpg
assets/stickers/preview_*.png
assets/stickers/_test.png

# Optional large CJK fonts (download yourself)
assets/fonts/LXGW*.ttf
assets/fonts/SourceHan*
assets/fonts/NotoSans*

# --- Optional local overrides / scratch ---
config.local.yaml
*.edit.yaml
!examples/**/*.yaml
!examples/**/*.edit.yaml
*.filter.txt
labels.yaml
*.labels.yaml
*.jsonl
